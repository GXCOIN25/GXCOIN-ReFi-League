# GXCOIN ReFi League - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=your_database_url_here
PGDATABASE=database_name
PGHOST=host
PGPASSWORD=password
PGPORT=5432
PGUSER=username

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your_super_secure_jwt_secret_key_here_at_least_32_chars_long
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_32_characters

# ============================================================================
# NFT & BLOCKCHAIN CONFIGURATION
# ============================================================================

# NFT Mode: 'demo' for testing, 'production' for real blockchain minting
VITE_NFT_MODE=demo

# Enable Real Blockchain Minting (requires deployed contracts)
VITE_ENABLE_REAL_MINTING=false

# ============================================================================
# SMART CONTRACT ADDRESSES - TESTNETS
# ============================================================================

# Ethereum Sepolia Testnet (Chain ID: 11155111)
VITE_HERO_NFT_CONTRACT_SEPOLIA=
VITE_GXCOIN_TOKEN_SEPOLIA=

# Ethereum Goerli Testnet (Chain ID: 5)
VITE_HERO_NFT_CONTRACT_GOERLI=
VITE_GXCOIN_TOKEN_GOERLI=

# Polygon Mumbai Testnet (Chain ID: 80001)
VITE_HERO_NFT_CONTRACT_MUMBAI=
VITE_GXCOIN_TOKEN_MUMBAI=

# BSC Testnet (Chain ID: 97)
VITE_HERO_NFT_CONTRACT_BSC_TESTNET=
VITE_GXCOIN_TOKEN_BSC_TESTNET=

# ============================================================================
# SMART CONTRACT ADDRESSES - MAINNETS (Production Only)
# ============================================================================

# Ethereum Mainnet (Chain ID: 1)
VITE_HERO_NFT_CONTRACT_ETHEREUM=
VITE_GXCOIN_TOKEN_ETHEREUM=

# Polygon Mainnet (Chain ID: 137)
VITE_HERO_NFT_CONTRACT_POLYGON=
VITE_GXCOIN_TOKEN_POLYGON=

# BNB Smart Chain Mainnet (Chain ID: 56)
VITE_HERO_NFT_CONTRACT_BSC=
VITE_GXCOIN_TOKEN_BSC=

# ============================================================================
# THIRDWEB INTEGRATION (Optional)
# ============================================================================

# Get your Client ID from: https://thirdweb.com/dashboard
VITE_THIRDWEB_CLIENT_ID=

# ============================================================================
# GITHUB OAUTH (Optional)
# ============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/oauth/callback

# ============================================================================
# STRIPE PAYMENT INTEGRATION (Optional)
# ============================================================================
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# For production Stripe webhooks (from Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Crypto Onramp (Optional - for direct crypto purchases)
VITE_STRIPE_CRYPTO_ONRAMP_KEY=

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. All VITE_ prefixed variables are exposed to the frontend
# 3. Always use strong, unique values for secrets and keys